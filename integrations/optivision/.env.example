# Optivision location profile
# Copy this file to an env file inside ./config/, e.g. Optivision-LowMoor.env
OPTIVISION_LOCATION=YourLocation
PROVIDER_NAME=Optivision
DATASOURCE_NAME=Optivision-YourLocation

# Veza
VEZA_URL=https://your-veza-tenant.example.com
VEZA_API_KEY=your_veza_api_key_here

# JDBC (SQL Server driver class is static across all locations)
JDBC_DATABASE_NAME=your_database_name
JDBC_URL=jdbc:sqlserver://hostname\\instance:port;encrypt=true;trustServerCertificate=true;databaseName=DBNAME
JDBC_USER=your_db_username
JDBC_PASSWORD=your_db_password
JDBC_DRIVER_CLASS=com.microsoft.sqlserver.jdbc.SQLServerDriver
JDBC_JAR_PATH=/opt/jdbc/mssql-jdbc-oracle-jre18.jar
JDBC_EXTRA_URL_OPTIONS=;encrypt=true;trustServerCertificate=true

# SQL
ACCOUNT_SQL=SELECT ua.vers_id, ua.user_id, ua.domain_name, ua.type_code, ua.user_name, ua.employee_id, ua.email_address, ua.phone_num, ua.mill_id, ua.department_id, ua.work_location, ua.supervisor, ua.supers_email_address, ua.ts_expire, ua.comment_line, ua.active_flag, ua.ts_installed, ua.ts_create, ua.ts_modified, ur.role_id, ur.seq_num FROM [opticov].[opticov].[user_account] ua LEFT JOIN [user_role] ur ON ua.user_id = ur.user_id WHERE ua.active_flag = 'Y'
ROLE_SQL=SELECT DISTINCT role_id FROM role ORDER BY role_id
